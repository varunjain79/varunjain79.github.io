---
/**
 * Original, self-contained kinetic monogram for the home hero.
 * Six vector planes transform the VJ initials into AI, without video,
 * canvas, external animation libraries, or third-party brand assets.
 */
---

<div class="fold-mark" data-fold-mark role="group" aria-label="Varun Jain's VJ monogram folds into the letters AI">
  <div class="fold-mark__top" aria-hidden="true">
    <span class="fold-mark__overline"><span class="fold-mark__signal"></span> VJ / MOTION STUDY</span>
    <span class="fold-mark__edition">NO. 001</span>
  </div>

  <div class="fold-mark__canvas" aria-hidden="true">
    <svg class="fold-mark__svg" viewBox="0 0 960 540" xmlns="http://www.w3.org/2000/svg" focusable="false">
      <defs>
        <linearGradient id="vj-paper" x1="0" y1="0" x2="0.9" y2="1">
          <stop offset="0" stop-color="#fff8e9" />
          <stop offset="1" stop-color="#dcd1bf" />
        </linearGradient>
        <linearGradient id="vj-orange" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#ff9b64" />
          <stop offset="1" stop-color="#e65a2f" />
        </linearGradient>
      </defs>
      <g class="fold-mark__planes">
        <polygon data-fold-plane points="109,124 160,96 323,400 273,428" fill="url(#vj-paper)" />
        <polygon data-fold-plane points="394,100 446,120 323,424 271,404" fill="url(#vj-paper)" />
        <polygon data-fold-plane points="540,100 860,100 860,153 540,153" fill="url(#vj-paper)" />
        <polygon data-fold-plane points="806,100 860,100 860,416 806,416" fill="url(#vj-paper)" />
        <polygon data-fold-plane points="704,390 860,390 860,443 704,443" fill="url(#vj-paper)" />
        <polygon data-fold-plane points="287,399 288,399 288,400 287,400" fill="url(#vj-orange)" opacity="0" />
      </g>
    </svg>
    <div class="fold-mark__orbit fold-mark__orbit--one"></div>
    <div class="fold-mark__orbit fold-mark__orbit--two"></div>
  </div>

  <div class="fold-mark__bottom">
    <div class="fold-mark__identity">
      <span class="fold-mark__tiny">IDENTITY, RECONSIDERED</span>
      <strong>VJ <span aria-hidden="true">/</span> AI</strong>
    </div>
    <button class="fold-mark__replay" type="button" aria-label="Replay the VJ to AI folding animation" hidden>
      <span aria-hidden="true">↺</span> Replay
    </button>
  </div>
  <div class="fold-mark__timeline" aria-hidden="true"><span data-fold-progress></span></div>
</div>

<script>
  // Every plane is a four-point polygon. The point counts stay identical
  // throughout the morph, so the geometry moves continuously rather than
  // crossfading between two unrelated logos.
  const planes = [
    { from: [109,124,160,96,323,400,273,428], to: [375,94,426,94,278,437,215,437] },
    { from: [394,100,446,120,323,424,271,404], to: [420,94,470,94,595,437,530,437] },
    { from: [540,100,860,100,860,153,540,153], to: [670,95,870,95,870,153,670,153] },
    { from: [806,100,860,100,860,416,806,416], to: [740,102,800,102,800,437,740,437] },
    { from: [704,390,860,390,860,443,704,443], to: [670,380,870,380,870,437,670,437] },
    { from: [287,399,288,399,288,400,287,400], to: [300,312,517,312,537,368,279,368] }
  ];

  const clamp = (value: number) => Math.max(0, Math.min(1, value));
  const ease = (value: number) => value < 0.5
    ? 4 * value * value * value
    : 1 - Math.pow(-2 * value + 2, 3) / 2;

  document.querySelectorAll<HTMLElement>('[data-fold-mark]').forEach((mark) => {
    const shapes = Array.from(mark.querySelectorAll<SVGPolygonElement>('[data-fold-plane]'));
    const replay = mark.querySelector<HTMLButtonElement>('.fold-mark__replay');
    const progressBar = mark.querySelector<HTMLElement>('[data-fold-progress]');
    if (shapes.length !== planes.length || !replay || !progressBar) return;

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let frameId = 0;
    let started = false;

    const render = (progress: number) => {
      shapes.forEach((shape, index) => {
        const plane = planes[index];
        // Stagger the planes so the result feels physically assembled.
        const delay = index === 5 ? 0.32 : (index % 3) * 0.065;
        const duration = index === 5 ? 0.56 : 0.79;
        const phase = clamp((progress - delay) / duration);
        const amount = ease(phase);
        const vertices = plane.from.map((value, point) => (
          value + (plane.to[point] - value) * amount
        ));
        shape.setAttribute('points', vertices.reduce<string[]>((pairs, value, point) => {
          if (point % 2 === 0) pairs.push(`${value.toFixed(2)},${vertices[point + 1].toFixed(2)}`);
          return pairs;
        }, []).join(' '));

        // A hinged, edge-on moment makes this a fold instead of a text fade.
        const hinge = Math.sin(Math.PI * phase);
        const direction = index % 2 ? 1 : -1;
        shape.style.transform = `perspective(850px) rotateY(${direction * hinge * 62}deg) translateY(${-hinge * 10}px)`;
        if (index === 5) shape.style.opacity = String(clamp((progress - 0.37) / 0.3));
      });
      progressBar.style.transform = `scaleX(${progress})`;
    };

    const complete = () => {
      render(1);
      replay.disabled = false;
      mark.dataset.state = 'complete';
    };

    const play = () => {
      cancelAnimationFrame(frameId);
      replay.disabled = true;
      mark.dataset.state = 'playing';
      render(0);
      const start = performance.now();
      const tick = (now: number) => {
        // A short opening hold makes the VJ initials legible before folding.
        const progress = clamp((now - start - 380) / 2450);
        render(progress);
        if (progress < 1) frameId = requestAnimationFrame(tick);
        else complete();
      };
      frameId = requestAnimationFrame(tick);
    };

    if (reducedMotion.matches) {
      complete();
      // No animation/replay control for people who prefer reduced motion.
      return;
    }

    replay.hidden = false;
    replay.addEventListener('click', play);

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        if (entries.some((entry) => entry.isIntersecting) && !started) {
          started = true;
          observer.disconnect();
          play();
        }
      }, { threshold: 0.25 });
      observer.observe(mark);
    } else {
      play();
    }
  });
</script>

<style>
  .fold-mark {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    aspect-ratio: 1;
    width: 100%;
    max-width: 520px;
    min-width: 0;
    justify-self: end;
    overflow: hidden;
    color: #f5f1e8;
    background: radial-gradient(ellipse at 52% 46%, #33423c 0%, #1e2825 72%);
    box-shadow: 17px 19px 0 #e65a2f;
  }
  .fold-mark::before {
    position: absolute;
    inset: 0;
    z-index: -1;
    content: '';
    background-image: linear-gradient(rgba(255,255,255,.045) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.045) 1px, transparent 1px);
    background-size: 42px 42px;
    mask-image: linear-gradient(to bottom, transparent 5%, black 45%, transparent 94%);
  }
  .fold-mark__top, .fold-mark__bottom {
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding-inline: clamp(19px, 4vw, 33px);
  }
  .fold-mark__top {
    padding-top: clamp(21px, 3vw, 30px);
    color: rgba(245,241,232,.67);
    font-size: .58rem;
    font-weight: 800;
    letter-spacing: .16em;
  }
  .fold-mark__overline { display: flex; align-items: center; gap: 10px; }
  .fold-mark__signal { height: 7px; width: 7px; border-radius: 50%; background: #e65a2f; }
  .fold-mark__edition { white-space: nowrap; }
  .fold-mark__canvas {
    position: relative;
    display: flex;
    flex: 1;
    min-height: 0;
    align-items: center;
    justify-content: center;
    padding: 12px 5px;
    perspective: 900px;
  }
  .fold-mark__svg { width: 100%; overflow: visible; position: relative; z-index: 1; }
  .fold-mark__planes polygon {
    transform-origin: center;
    transform-box: fill-box;
    will-change: transform;
    filter: drop-shadow(4px 8px 3px rgba(0,0,0,.18));
  }
  .fold-mark__orbit {
    position: absolute;
    inset: 10%;
    border: 1px solid rgba(245,241,232,.07);
    border-radius: 50%;
    pointer-events: none;
  }
  .fold-mark__orbit--two { inset: 19%; }
  .fold-mark__bottom {
    align-items: flex-end;
    padding-bottom: clamp(24px, 4vw, 35px);
  }
  .fold-mark__identity { display: flex; flex-direction: column; gap: 3px; }
  .fold-mark__tiny { color: rgba(245,241,232,.5); font-size: .57rem; letter-spacing: .11em; font-weight: 750; }
  .fold-mark__identity strong { font-size: 1.23rem; letter-spacing: -.06em; line-height: 1; }
  .fold-mark__identity strong span { color: #e65a2f; font-weight: 400; padding: 0 .2em; }
  .fold-mark__replay {
    padding: 6px 0 2px 8px;
    border: 0;
    background: transparent;
    color: #f5f1e8;
    font: inherit;
    font-size: .76rem;
    cursor: pointer;
    white-space: nowrap;
  }
  .fold-mark__replay span { display: inline-block; margin-right: 5px; color: #ff9878; font-size: 1.2rem; vertical-align: -.08em; }
  .fold-mark__replay:hover { color: #ff9878; }
  .fold-mark__replay:focus-visible { outline: 2px solid #ff9878; outline-offset: 6px; }
  .fold-mark__replay:disabled { opacity: .35; cursor: default; }
  .fold-mark__replay[hidden] { display: none; }
  .fold-mark__timeline { position: absolute; left: 0; right: 0; bottom: 0; height: 3px; background: rgba(255,255,255,.08); }
  .fold-mark__timeline span { display: block; width: 100%; height: 100%; background: #e65a2f; transform: scaleX(0); transform-origin: left center; }
  @media (max-width: 900px) {
    .fold-mark { justify-self: center; }
  }
  @media (max-width: 600px) {
    .fold-mark { box-shadow: 12px 14px 0 #e65a2f; }
    .fold-mark__top { font-size: .55rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .fold-mark__planes polygon { will-change: auto; }
    .fold-mark__replay { display: none; }
  }
</style>
