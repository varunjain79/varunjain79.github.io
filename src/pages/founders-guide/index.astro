---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';

const posts = (await getCollection('foundersGuide', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf());
---

<BaseLayout
  title="Founder’s Guide | Varun Jain"
  description="First-hand guides from Varun Jain on building a personal brand, platform risk, AI automation, hiring and technology."
  canonical="/founders-guide/"
>
  <header class="collection-hero shell">
    <p class="eyebrow">Founder’s Guide</p>
    <h1>Experience, converted into useful systems.</h1>
    <p>Long-form, first-hand writing on building, hiring, careers, technology and the mistakes that only become obvious after you make them.</p>
    <label class="search-box">
      <span>Search the guide</span>
      <input id="guide-search" type="search" placeholder="Try “personal brand” or “Astro”" autocomplete="off" />
    </label>
  </header>

  <section class="shell collection-list" aria-live="polite">
    <p id="search-status" class="search-status">{posts.length} guides</p>
    <div class="post-grid" id="post-grid">
      {posts.map((post) => (
        <PostCard
          href={`/founders-guide/${post.id}/`}
          title={post.data.title}
          description={post.data.description}
          category={post.data.category}
          readingTime={post.data.readingTime}
        />
      ))}
    </div>
  </section>

  <script>
    const search = document.querySelector<HTMLInputElement>('#guide-search');
    const cards = [...document.querySelectorAll<HTMLElement>('.post-card')];
    const status = document.querySelector<HTMLElement>('#search-status');
    search?.addEventListener('input', () => {
      const query = search.value.trim().toLowerCase();
      let visible = 0;
      cards.forEach((card) => {
        const match = !query || card.dataset.search?.includes(query);
        card.hidden = !match;
        if (match) visible += 1;
      });
      if (status) status.textContent = `${visible} ${visible === 1 ? 'guide' : 'guides'}`;
    });
  </script>
</BaseLayout>
